{
  "name": "store-ledger-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter=!store-ledger-monorepo run build",
    "typecheck": "pnpm -r --filter=!store-ledger-monorepo run typecheck",
    "test": "pnpm -r --filter=!store-ledger-monorepo run test",
    "lint": "pnpm run format:check && pnpm -r --filter=!store-ledger-monorepo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:sql": "node scripts/check-sql-injection.js"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
